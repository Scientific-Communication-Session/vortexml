# Copy this file to `.env` (already git-ignored) and fill in real values.
# `start.sh` sources `.env` before launching, so anything you set here ends up
# in the backend's environment.

# Required to enable the Novice-mode chatbot. Without it, /api/chat returns 503
# and the frontend hides the chat UI for novices.
ANTHROPIC_API_KEY=

# REQUIRED in production. Flask session signing key — a hardcoded/shared key
# lets anyone forge a session cookie for any account. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# In dev it may be left blank (a random per-process key is used; sessions then
# reset on each restart). With FLASK_ENV=production the server refuses to start
# unless this is set.
VORTEX_SECRET_KEY=

# Database URL including credentials. If unset, the backend uses a local SQLite
# file (backend/vortex.db). Point this at PostgreSQL in deployment, e.g.
#   VORTEX_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/vortex_db
# VORTEX_DATABASE_URL=

# Optional. Force the backend onto SQLite even when a DB URL is set.
# VORTEX_USE_SQLITE=1

# Production hardening flags:
#   FLASK_ENV=production       — require VORTEX_SECRET_KEY, fail fast if missing
#   VORTEX_COOKIE_SECURE=1     — mark the session cookie Secure (HTTPS only)
#   VORTEX_BIND=0.0.0.0        — bind address (default 127.0.0.1; let a proxy
#                                own public exposure)
#   FLASK_DEBUG=1              — DEV ONLY; enables the Werkzeug debugger
#   VORTEX_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
#                             — extra browser origins allowed for CORS + sockets
# FLASK_ENV=production
# VORTEX_COOKIE_SECURE=1

# Public URL of this server, baked into downloaded node-agent bundles so a
# user's own machine knows where to dial back in. Defaults to the production
# tunnel. Override it for local testing, e.g. http://192.168.100.95:5173
# VORTEX_PUBLIC_URL=https://vortexml.andreinita.com
